# AI-SOC Firewall Response - Environment Configuration
# 
# Required environment variables:
# - DATABASE_URL: Path to SQLite database (default: ./audit.db)
# - SECRET_KEY: Secret key for JWT tokens
# - DEBUG: Enable debug mode (default: False)
#
# Optional environment variables:
# - VITE_API_URL: Frontend API URL (default: http://127.0.0.1:8001/api/v1)
# - VITE_WS_BASE_URL: WebSocket base URL

DATABASE_URL=./audit.db
SECRET_KEY=your-secret-key-here
DEBUG=False