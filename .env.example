# Environment variables referenced by the application.
# See https://vitejs.dev/guide/env-and-mode.html for more information.

# API base URL (used by frontend axios instance)
VITE_API_URL=http://127.0.0.1:8001/api/v1

# WebSocket base URL (derived from VITE_API_URL if not set)
# If not provided, the frontend will derive WS URL from VITE_API_URL
VITE_WS_BASE_URL=

# Backend JWT secret (required for authentication)
# This must be set in production - the application will fail to start
# if JWT_SECRET is not provided via environment variable.
JWT_SECRET=a-very-secret-key-at-least-32-chars-long!!PUBLIC_ORIGIN=https://soc.example.com
SECRET_KEY=ySsVUPtuA2YNbsUTWLVG-rZX-u1oT1QyaZz05pJjQ5hXnRGTp3WYd_Eypy89lB40
MONGO_DB=ai_soc_firewall
DOCS_ENABLED=false
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_LOGIN=5/minute